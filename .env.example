# ===== 後端環境變數設定 =====
# 開發期：
# 1. 將此檔案複製到 backend/.env
# 2. 在 backend/ 執行 npm run dev 啟動後端
# 3. PostgreSQL 資料庫在 Docker，這時的 DB_HOST 是使用 localhost
#
# 容器化後：
# backend 的環境變數變成由 docker-compose.yml 設定；
# 容器內連線 PostgreSQL 時，DB_HOST 應設為 postgres。

PORT=8080

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=rfitness_app
DB_PASSWORD=rfitness_local_password
DB_DATABASE=fitness

JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_DAY=30d

# DB_SYNCHRONIZE 僅供空白開發與測試資料庫初始化。既有資料庫建議停用。
DB_SYNCHRONIZE=true
DB_ENABLE_SSL=false
