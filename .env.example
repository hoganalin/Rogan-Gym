# ===== 後端環境變數設定 =====
# 開發期：
# 1. 將此檔案複製到 backend/.env
# 2. 在 backend/ 執行 npm run dev 啟動後端
# 3. PostgreSQL 資料庫在 Docker，這時的 DB_HOST 是使用 localhost
#
# 容器化後：
# backend 的環境變數變成由 docker-compose.yml 設定；
# 容器內連線 PostgreSQL 時，DB_HOST 應設為 postgres。（後續到容器化步驟時，就會比較理解這個部分）

PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rfitness_demo
DB_PASSWORD=rfitness_demo_password
DB_DATABASE=fitness

JWT_SECRET=請換成你自己的亂數字串
JWT_EXPIRES_DAY=30d

# 下面兩個可依需求調整：
# 想改用 migration 管理 schema：把 DB_SYNCHRONIZE 改成 false，改用 npm run migration:run 建表
# （CI 預設仍帶 true，走哪條路都不影響 CI 結果）
DB_SYNCHRONIZE=true
DB_ENABLE_SSL=false
