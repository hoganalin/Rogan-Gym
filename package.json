{
  "name": "r-fitness",
  "version": "1.0.0",
  "private": true,
  "description": "R Fitness — 健身房課程預約平台，後端 API 與前端。",
  "scripts": {
    "dev:local": "node scripts/start-local.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "start": "node .github/scripts/check-backend.js && npm --prefix backend start",
    "test": "jest --runInBand",
    "test:catalog": "jest test/catalog.test.js --runInBand",
    "test:accounts": "jest test/accounts.test.js --runInBand",
    "test:coach-management": "jest test/coach-management.test.js --runInBand",
    "test:discovery": "jest test/discovery.test.js --runInBand",
    "test:bookings": "jest test/bookings.test.js --runInBand",
    "test:revenue": "jest test/revenue.test.js --runInBand",
    "test:smoke": "jest test/smoke.test.js --runInBand",
    "db:reset": "docker compose down -v && docker compose up -d",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "verify:demo": "node backend/scripts/verify-demo.js"
  },
  "jest": {
    "testMatch": ["<rootDir>/test/**/*.test.js"],
    "testEnvironment": "node",
    "testTimeout": 15000,
    "modulePathIgnorePatterns": [
      "<rootDir>/backend/"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.0.0"
  }
}
